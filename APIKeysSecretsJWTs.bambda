id: aee0fa61-1393-4b1d-867a-c90f74fe2ad8
name: "API Keys, Secrets & JWTs"
function: VIEW_FILTER
location: PROXY_HTTP_HISTORY
source: "// Secrets & API Keys\r\nif (!requestResponse.hasResponse()) return false;\r\
  \n\r\nString query = requestResponse.finalRequest().query() != null ? requestResponse.finalRequest().query().toLowerCase()\
  \ : \"\";\r\nString body = requestResponse.finalRequest().bodyToString().toLowerCase();\r\
  \nString resBody = requestResponse.response().bodyToString().toLowerCase();\r\n\r\
  \nString[] secrets = {\"api_key\", \"apikey\", \"access_token\", \"secret\", \"\
  client_secret\", \"bearer \", \"authorization: bearer\"};\r\nfor (String s : secrets)\
  \ {\r\n    if (query.contains(s) || body.contains(s) || resBody.contains(s)) return\
  \ true;\r\n}\r\njava.util.regex.Pattern aws = java.util.regex.Pattern.compile(\"\
  AKIA[0-9A-Z]{16}\");\r\njava.util.regex.Pattern jwt = java.util.regex.Pattern.compile(\"\
  eyJ[A-Za-z0-9_-]+\\\\.[A-Za-z0-9_-]+\\\\.[A-Za-z0-9_-]+\");\r\nif (aws.matcher(resBody).find()\
  \ || jwt.matcher(resBody).find()) return true;\r\nreturn false;"
